# Copy to .env.local and fill in. Never commit real secrets.

# ── Site ───────────────────────────────────────────────────────────────
# Canonical production URL (used for metadata, sitemap, OG, hreflang).
NEXT_PUBLIC_SITE_URL=https://drparispapakostas.com

# ── Sanity CMS (Phase 2b) — set after creating the Sanity project ───────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-02
# OPTIONAL read-only (Viewer) token, used by the site at BUILD TIME only, for a
# dataset whose published content is not yet anonymously readable. When the
# dataset is fully public, leave this empty — reads go through the CDN, no token.
# This is the ONLY Sanity token the site/build ever uses; it is never a write token.
# Create in sanity.io/manage → API → Tokens (Viewer).
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook → /api/revalidate (on-demand ISR).
SANITY_REVALIDATE_SECRET=

# ── WordPress migration (Phase 2c) ─────────────────────────────────────
# Absolute path to the WordPress WXR export (read-only, outside the repo).
WP_EXPORT_PATH=
# Target dataset for the migration dry-run import (keep separate from prod).
SANITY_MIGRATION_DATASET=development
# MIGRATION-ONLY write token (Editor), used solely by scripts/migrate-wp.ts and
# scripts/seed-home.ts. NEVER read by the site or the build. Set it in .env.local
# (gitignored) only when running a migration/seed; keep it out of version control.
# SANITY_API_WRITE_TOKEN=   # set in .env.local for migration/seed scripts only

# ── Booking — Cal.com ──────────────────────────────────────────────────
# Cal.com page/event SLUG (not the full URL), e.g. "paris-papakostas-e5fgm9"
# or "username/event". "Book a consultation" / "Plan your visit" open the
# Cal.com popup; the embed loads on first interaction. When empty, the buttons
# link to /contact. Set the same value in Netlify for the deploy.
NEXT_PUBLIC_CAL_LINK=paris-papakostas-e5fgm9

# ── Analytics & consent (Phase 5) ──────────────────────────────────────
# Google Tag Manager container id (GTM-XXXXXXX). When empty, NO GTM/consent
# script loads. When set, Consent Mode v2 defaults to all-denied until the
# consent banner (ConsentBanner — swap for your CMP) grants it.
NEXT_PUBLIC_GTM_ID=

# ── Contact form email (Phase 5) — SMTP (or use Netlify Forms) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
